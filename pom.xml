<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>by.edu.example</groupId>
    <artifactId>task-manager-cicd</artifactId>
    <version>1.0.0</version>
    <name>task-manager-cicd</name>
    <description>Учебное REST-приложение для лабораторной работы по CI (Jenkins + GitHub Actions)</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <jacoco.version>0.8.15</jacoco.version>

        <!-- Вариант 15 (часть 2): пороги quality gate JaCoCo.
             Значения по умолчанию можно переопределить из CI:
             mvn verify -Dcoverage.line.minimum=0.90 -Dcoverage.branch.minimum=0.70 -->
        <coverage.line.minimum>0.80</coverage.line.minimum>
        <coverage.branch.minimum>0.60</coverage.branch.minimum>

        <!-- Учебный тест CiDemoTest по умолчанию исключён из сборки. -->
        <ci.demo.excludes>**/CiDemoTest.java</ci.demo.excludes>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- HTTP-клиент для PATCH-запросов в интеграционных тестах -->
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Исполняемый JAR: target/task-manager-cicd-1.0.0.jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Модульные тесты (*Test.java) на фазе test -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>${ci.demo.excludes}</exclude>
                        <exclude>**/*IT.java</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Интеграционные тесты (*IT.java) на фазах integration-test и verify -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- HTML-отчёт Surefire (mvn surefire-report:report-only) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-report-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
            </plugin>

            <!-- JaCoCo: сбор покрытия, HTML-отчёт и quality gate -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <excludes>
                        <!-- Точка входа Spring Boot не содержит логики -->
                        <exclude>by/edu/example/taskmanager/TaskManagerApplication.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <!-- Подключает агент JaCoCo к JVM Surefire и Failsafe (через argLine) -->
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <!-- HTML/XML/CSV-отчёт после модульных и интеграционных тестов -->
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!-- Quality gate: сборка падает, если покрытие ниже порога -->
                    <execution>
                        <id>check-coverage</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${coverage.line.minimum}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${coverage.branch.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Включается параметром -Dci.demo.failTest=true:
             учебный CiDemoTest попадает в прогон и намеренно падает. -->
        <profile>
            <id>ci-demo-fail</id>
            <activation>
                <property>
                    <name>ci.demo.failTest</name>
                    <value>true</value>
                </property>
            </activation>
            <properties>
                <ci.demo.excludes>**/NothingExcluded.java</ci.demo.excludes>
            </properties>
        </profile>
    </profiles>
</project>
